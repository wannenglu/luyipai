.container{
  padding:30rpx;
  background:#f7f8fa;
  min-height:100vh;
}
.search-bar{
  display:flex;
  gap:16rpx;
  margin-bottom:30rpx;
}
.search-input{
  flex:1;
  background:#fff;
  height:88rpx;
  line-height:88rpx;
  padding:0 24rpx;
  border-radius:10rpx;
  border:1rpx solid #e5e7eb;
  font-size:30rpx;
}
.search-btn{
  width:140rpx;
  background:#007aff;
  color:#fff;
}
.search-btn::after{border:none;}

.item{
  background:#fff;
  border-radius:12rpx;
  padding:24rpx;
  margin-bottom:16rpx;
}
.info{
  font-size:26rpx;
  color:#444;
  line-height:1.8;
  display:flex;
  flex-direction:column;
  gap:6rpx;
}
.btn-group{
  display:flex;
  gap:16rpx;
  margin-top:16rpx;
}
.page-bar{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:20rpx;
  margin-top:40rpx;
}
.page-bar text {
  width: 120rpx;
  text-align: center;
}
