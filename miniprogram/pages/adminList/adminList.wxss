.container{
  padding:30rpx;
  background:#f7f8fa;
  min-height:100vh;
}
.search-bar{
  display:flex;
  align-items:center;
  gap:20rpx;
  margin-bottom:30rpx;
}
.search-wrap{
  flex:1;
  position:relative;
}
.search-input{
  width:100%;
  box-sizing:border-box;
  background:#fff;
  height:88rpx;
  line-height:88rpx;
  padding:0 70rpx 0 24rpx;
  border-radius:12rpx;
  font-size:30rpx;
}
.search-clear{
  position:absolute;
  right:20rpx;
  top:0;
  height:88rpx;
  line-height:88rpx;
  font-size:32rpx;
  color:#999;
  padding:0 10rpx;
  z-index:2;
}
.refresh-btn{
  width:88rpx;
  height:88rpx;
  background:#fff;
  border-radius:12rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:44rpx;
  color:#007aff;
  flex-shrink:0;
}

.item{
  background:#fff;
  border-radius:12rpx;
  padding:24rpx;
  margin-bottom:16rpx;
}
.info{
  font-size:26rpx;
  color:#444;
  line-height:1.8;
  display:flex;
  flex-direction:column;
  gap:6rpx;
}
.btn-group{
  display:flex;
  gap:16rpx;
  margin-top:16rpx;
}
.page-bar{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:20rpx;
  margin-top:40rpx;
}
.page-bar text {
  width: 120rpx;
  text-align: center;
}
