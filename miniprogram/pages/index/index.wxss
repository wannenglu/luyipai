page{
  background:#f7f8fa;
  min-height: 100vh;
}
.header{
  padding:40rpx 30rpx 20rpx;
  text-align:center;
}
.title{
  font-size:40rpx;
  font-weight:bold;
}
.sub{
  font-size:24rpx;
  color:#888;
  margin-top:10rpx;
}

/* 搜索框修复 */
.search-wrap{
  margin:20rpx 30rpx;
  position:relative;
}
.search-input{
  width:100%;
  box-sizing:border-box;
  background:#fff;
  border-radius:12rpx;
  padding:0 70rpx 0 24rpx;
  font-size:28rpx;
  height:88rpx;
  line-height:88rpx;
}
.search-clear{
  position:absolute;
  right:30rpx;
  top:0;
  height:88rpx;
  line-height:88rpx;
  font-size:32rpx;
  color:#999;
  padding:0 10rpx;
  z-index:2;
}

.qrcode-btn{
  margin: 20rpx 30rpx;
  height:100rpx;
  background:#00b85c;
  border-radius:16rpx;
  color:#fff;
  font-size:36rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:30rpx;
}

.empty{
  text-align:center;
  padding:100rpx 0;
  color:#666;
}
.list{
  padding:0 30rpx;
}
.item{
  background:#fff;
  border-radius:12rpx;
  margin-bottom:20rpx;
  padding:30rpx;
  position:relative;
}
/* 第一行：版本号 + 标签 左右分布 */
.item-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.ver{
  font-weight:bold;
  font-size:34rpx;
}
.remark-tag{
  font-size:24rpx;
  background:#e6f0ff;
  color:#3478e8;
  padding:4rpx 12rpx;
  border-radius:8rpx;
}
/* 第二行日期单独一行 */
.date-row{
  margin:8rpx 0 16rpx;
}
.date{
  color:#777;
  font-size:24rpx;
}

/* 更新日志 折叠核心样式 */
.log-wrap {
  margin: 16rpx 0;
}
.log-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  word-break: break-all;
  word-wrap: break-word;
  white-space: pre-wrap;
}

.copy-btn{
  background:#007aff;
  color:#fff;
  font-size:26rpx;
  width:220rpx;
}

/* 二维码弹窗样式 */
.qrcode-mask{
  position:fixed;
  top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,0.7);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:998;
}
.modal-inner{
  width:72%;
  background:#fff;
  border-radius:20rpx;
  padding:40rpx 30rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
}
.modal-title{
  font-size:36rpx;
  font-weight:bold;
  margin-bottom:30rpx;
}
.ewm{
  width:70%;
  display:block;
}
.modal-close{
  margin-top:40rpx;
  padding:16rpx 60rpx;
  background:#eee;
  border-radius:12rpx;
  font-size:32rpx;
}

.page-tip{
  text-align:center;
  padding:30rpx 0;
  font-size:26rpx;
  color:#999;
}
