.mask{
  position:fixed;
  top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,0.6);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:999;
}
.dialog{
  width:82%;
  background:#fff;
  border-radius:16rpx;
  padding:40rpx 30rpx;
}
.title{
  font-size:34rpx;
  font-weight:bold;
  text-align:center;
  margin-bottom:30rpx;
}
.input-wrap{
  position:relative;
  margin-bottom:30rpx;
}
.input{
  width:100%;
  box-sizing:border-box;
  height:88rpx;
  line-height:88rpx;
  border:1rpx solid #eee;
  border-radius:8rpx;
  padding:0 88rpx 0 24rpx;
  font-size:30rpx;
}
.eye-btn{
  position:absolute;
  right:20rpx;
  top:0;
  bottom:0;
  display:flex;
  align-items:center;
  font-size:34rpx;
  z-index:2;
}
.btn{
  background:#007aff;
  color:#fff;
}
