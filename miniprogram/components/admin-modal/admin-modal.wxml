<view wx:if="{{visible}}" class="mask" bindtap="maskClose">
  <view class="dialog" catchtap="stop">
    <view class="title">管理员验证</view>
    <view class="input-wrap">
      <input class="input" placeholder="管理员密码" password="{{pwdHide}}" bindinput="onInput" bindconfirm="confirm" value="{{pwd}}"/>
      <view class="eye-btn" catchtap="togglePwd">{{pwdHide ? '👁️' : '🙈'}}</view>
    </view>
    <button bindtap="confirm" class="btn">确认</button>
  </view>
</view>
