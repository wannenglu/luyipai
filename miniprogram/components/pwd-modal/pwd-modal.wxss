.mask{
  position:fixed;
  top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,0.6);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:999;
}
.dialog{
  width:86%;
  background:#fff;
  border-radius:16rpx;
  padding:40rpx 32rpx;
  box-sizing:border-box;
}
.title{
  font-size:42rpx;
  font-weight:bold;
  text-align:center;
  margin-bottom:24rpx;
}
.tip-wrap{
  background:#f0fcf4;
  border-left:6rpx solid #36c765;
  padding:24rpx 20rpx;
  margin-bottom:32rpx;
  text-align:center;
}
.tip-text{
  font-size:30rpx;
  color:#333;
  margin-bottom:12rpx;
}
.official, .keyword{
  font-size:32rpx;
  margin:8rpx 0;
  color:#444;
}
.green{
  color:#23a854;
  font-weight:bold;
}
/* 大幅缩减二维码上下空白，紧贴文字 */
.qr-img{
  width:60%;
  margin:10rpx auto;
  border-radius:12rpx;
  display:block;
  vertical-align:top;
}
.qr-tip{
  font-size:26rpx;
  color:#666;
  margin-top:4rpx;
}
.input-wrap{
  position:relative;
  width:100%;
  margin-bottom:30rpx;
}
.pwd-input{
  width:100%;
  box-sizing:border-box;
  border:2rpx solid #63a8ff;
  border-radius:12rpx;
  height:88rpx;      /* 固定整体高度 */
  padding:0 24rpx;   /* 取消上下padding，只保留左右 */
  font-size:32rpx;
  line-height:88rpx; /* 和height一致，文字垂直居中 */
}
.eye-btn{
  position:absolute;
  right:24rpx;
  top:50%;
  transform:translateY(-50%);
  font-size:38rpx;
  color:#333;
  padding:12rpx;
  z-index:2;
}
.btn{
  width:100%;
  background:#007aff;
  color:#fff;
  font-size:34rpx;
  border-radius:12rpx;
}
